# Copy to .env (gitignored) before running docker-compose for a temporary
# public-tunnel session. Every value here has a safe localhost-only default
# baked into docker-compose.yml, so this file is entirely optional for
# plain local `docker-compose up`.

# Set this once you have a tunnel running (e.g. `cloudflared tunnel --url
# http://localhost:8080`), to the https://*.trycloudflare.com URL it prints.
# CLIENT_URL and BETTER_AUTH_URL both read from this — the client and API
# are served from one origin behind nginx, so there's only one public URL.
PUBLIC_URL=http://localhost:8080

# Generate real random values (e.g. `openssl rand -base64 32` in Git Bash)
# before exposing this stack to anyone outside your own machine. Never
# reuse the checked-in dev defaults for a session real people log into.
BETTER_AUTH_SECRET=
SYNC_TICKET_SECRET=
POSTGRES_PASSWORD=

# Video calls: leave all three blank to keep using the self-hosted `livekit`
# service (same-machine only — fine for local dev, not reachable by friends
# over a tunnel). To make calls actually work for a remote friend, sign up
# free at https://cloud.livekit.io, create a project, and fill these in from
# its Settings > Keys page:
LIVEKIT_CLOUD_URL=
LIVEKIT_CLOUD_API_KEY=
LIVEKIT_CLOUD_API_SECRET=
